# 국토교통부 실거래가 API 인증키(공공데이터포털 디코딩 키)
DATA_GO_KR_SERVICE_KEY=your_decoded_service_key_here

# VWorld 연속지적도·주소 검색 API 인증키
# 브라우저에 노출되지 않도록 VITE_ 접두사를 사용하지 않습니다.
VWORLD_API_KEY=your_vworld_api_key_here

# VWorld 인증키 발급 시 등록한 서비스 도메인(끝의 / 제외)
# 로컬 개발 예: http://localhost:3000
VWORLD_DOMAIN=http://localhost:3000
